# Server Configuration
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/allinonestore
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Mock or Real)
PAYMENT_KEY_ID=your_payment_key_id
PAYMENT_KEY_SECRET=your_payment_key_secret

# Image Storage / Cloudinary (If applicable)
IMAGE_STORAGE_URL=your_storage_url
IMAGE_STORAGE_KEY=your_storage_key
IMAGE_STORAGE_SECRET=your_storage_secret

# Client Configuration (Add VITE_ prefix)
VITE_API_URL=http://localhost:5000/api
